+/// [hwpedit] 문단이 품은 자리차지 표(비-TAC, 위아래 배치, 세로 기준=문단)의 흐름 end.
+///
+/// 한컴은 이런 표 host 문단의 LINE_SEG 를 글자 한 줄(lh=1000)로 저장하지만, 다음 문단의
+/// vpos 는 `host vpos + 세로 오프셋 + 표 높이 + 바깥 여백 위·아래` 에 둔다
+/// (rhwp `samples/tb-img-03.hwp`: host vpos 0, 표 18216 + 283 + 283 → 다음 문단 vpos 18782).
+/// 줄 높이만으로 흐름을 이으면 표 아래 문단과 그 다음 표가 앞 표 위에 저장되어 겹친다.
+pub(crate) fn host_table_flow_end(para: &Paragraph) -> Option<i32> {
+    use crate::model::shape::{TextWrap, VertRelTo};
+    let first = para.line_segs.first()?.vertical_pos;
+    para.controls
+        .iter()
+        .filter_map(|ctrl| match ctrl {
+            Control::Table(t)
+                if !t.common.treat_as_char
+                    && t.common.text_wrap == TextWrap::TopAndBottom
+                    && t.common.vert_rel_to == VertRelTo::Para =>
+            {
+                Some(
+                    first
+                        .saturating_add(t.common.vertical_offset as i32)
+                        .saturating_add(t.common.height as i32)
+                        .saturating_add(i32::from(t.outer_margin_top))
+                        .saturating_add(i32::from(t.outer_margin_bottom)),
+                )
+            }
+            _ => None,
+        })
+        .max()
