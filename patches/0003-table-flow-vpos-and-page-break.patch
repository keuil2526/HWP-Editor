+    /// 손대지 않은 표의 저장값은 바뀌지 않는다. 바뀐 것이 있으면 true.
+    pub fn sync_table_flow_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        control_idx: usize,
+    ) -> Result<bool, HwpError> {
+        use crate::model::shape::{TextWrap, VertRelTo};
+        self.paginate_if_needed();
+        let measured_hu = self
+            .measured_tables
+            .get(section_idx)
+            .and_then(|tables| {
+                tables
+                    .iter()
+                    .find(|m| m.para_index == parent_para_idx && m.control_index == control_idx)
+            })
+            .map(|m| crate::renderer::px_to_hwpunit(m.total_height - m.caption_height, self.dpi));
+        let para = self
+            .document
+            .sections
+            .get_mut(section_idx)
+            .and_then(|s| s.paragraphs.get_mut(parent_para_idx))
+            .ok_or_else(|| HwpError::RenderError("표 문단을 찾을 수 없습니다".to_string()))?;
+        let Some(Control::Table(table)) = para.controls.get_mut(control_idx) else {
+            return Err(HwpError::RenderError("표를 찾을 수 없습니다".to_string()));
+        };
+        if table.common.treat_as_char
+            || table.common.text_wrap != TextWrap::TopAndBottom
+            || table.common.vert_rel_to != VertRelTo::Para
+        {
+            return Ok(false);
+        }
+        let mut changed = false;
+        if let Some(h) = measured_hu.filter(|&h| h > 0 && h as u32 != table.common.height) {
+            table.sync_ctrl_height(h as u32);
+            changed = true;
+        }
+        let before: Vec<i32> = self.document.sections[section_idx].paragraphs[parent_para_idx..]
+            .iter()
+            .map(|p| p.line_segs.first().map_or(0, |ls| ls.vertical_pos))
+            .collect();
+        let doc_hwp3_layout = self.document.layout_profile().hwp3_layout();
+        crate::renderer::composer::recalculate_section_vpos(
+            &mut self.document.sections[section_idx].paragraphs,
+            parent_para_idx,
+            Some(parent_para_idx..parent_para_idx + 1),
+            None,
+            &self.styles,
+            self.dpi,
+            doc_hwp3_layout,
+        );
+        let moved = self.document.sections[section_idx].paragraphs[parent_para_idx..]
+            .iter()
+            .zip(&before)
+            .any(|(p, &b)| p.line_segs.first().map_or(0, |ls| ls.vertical_pos) != b);
+        if changed || moved {
+            self.document.sections[section_idx].raw_stream = None;
+            self.recompose_section(section_idx);
+            self.paginate_if_needed();
+        }
+        Ok(changed || moved)
+    }
