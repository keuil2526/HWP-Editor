+/// [hwpedit 0011] 수식 기준선 위치(상자 높이에 대한 %, 수식 레코드의 baseline)를
+/// 수식 레이아웃에서 계산한다. 한글도 수식마다 다시 계산해 저장한다(한글 2022 재저장본:
+/// 근의 공식 71, 합 63, 2×2 행렬 67, α+β=π 86 — 85 로 저장한 파일도 한글은 자기 값으로
+/// 그리고 고쳐 저장). 85 고정은 그림(레이아웃 기준선)과 줄 기준선을 어긋나게 했다.
+pub fn intrinsic_baseline_pct(script: &str, font_size: u32) -> i16 {
+    let font_size_px = super::hwpunit_to_px(font_size.max(1) as i32, super::DEFAULT_DPI);
+    let ast = parser::EqParser::new(tokenizer::tokenize(script)).parse();
+    let layout = layout::EqLayout::new(font_size_px).layout(&ast);
+    if layout.height <= 0.0 {
+        return 85;
+    }
+    ((layout.baseline / layout.height) * 100.0).round().clamp(1.0, 100.0) as i16
+}
