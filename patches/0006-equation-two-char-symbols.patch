diff --git a/src/renderer/equation/parser.rs b/src/renderer/equation/parser.rs
index fd0e0a69..88b93929 100644
--- a/src/renderer/equation/parser.rs
+++ b/src/renderer/equation/parser.rs
@@ -236,6 +236,11 @@ impl EqParser {
                 // -> 는 →로 변환
                 if val == "->" {
                     EqNode::MathSymbol("→".to_string())
+                } else if val.chars().count() > 1 {
+                    // [hwpedit] 두 글자 기호(+- <= >= != << >>)는 기호표의 글자로 그린다.
+                    // 종전에는 `+-` 등이 글자 그대로 찍혔다 (한글 2022는 ± ≤ … 로 그림).
+                    let sign = lookup_symbol(&val).map(str::to_owned);
+                    EqNode::Symbol(sign.unwrap_or(val))
                 } else {
                     EqNode::Symbol(val)
                 }
