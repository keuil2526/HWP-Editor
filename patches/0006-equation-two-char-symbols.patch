diff --git a/src/renderer/equation/tokenizer.rs b/src/renderer/equation/tokenizer.rs
index 93c7487f..fff13743 100644
--- a/src/renderer/equation/tokenizer.rs
+++ b/src/renderer/equation/tokenizer.rs
@@ -314,7 +314,8 @@ impl Tokenizer {
 
         // 2문자 기호
         let two: String = [ch, next].iter().collect();
-        if matches!(two.as_str(), "<=" | ">=" | "!=" | "==" | "<<" | ">>") {
+        // [hwpedit] `+-` 는 한컴 수식의 ± (한글 2022 PDF로 확인: feature_lab f09)
+        if matches!(two.as_str(), "<=" | ">=" | "!=" | "==" | "<<" | ">>" | "+-") {
             self.pos += 2;
             return Some(Token::new(TokenType::Symbol, two, start));
         }
