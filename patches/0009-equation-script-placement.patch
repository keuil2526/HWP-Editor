+/// [hwpedit 0009] 이탤릭 글자로 끝나는 밑글자 뒤 위첨자의 간격.
+fn italic_correction(base: &LayoutBox, fs: f64) -> f64 {
+    let last = match &base.kind {
+        LayoutKind::Text(t) if !super::text_has_cjk(t) => t.chars().last(),
+        LayoutKind::Row(c) => return c.last().map_or(0.0, |b| italic_correction(b, fs)),
+        _ => None,
+    };
+    // 글리프 끝에 딱 붙지 않도록 넘치는 글자에는 0.05em 을 더 띄운다.
+    match last {
+        Some(ch) if ch.is_ascii_alphabetic() => {
+            let ic = STIX_ITALIC_CORRECTION[(ch as u8 - b'A') as usize];
+            if ic > 0.0 {
+                fs * (ic + 0.05)
+            } else {
+                0.0
+            }
+        }
+        _ => 0.0,
+    }
 }
 
