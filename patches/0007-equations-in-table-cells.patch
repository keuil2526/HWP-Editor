+    /// [hwpedit] 표 셀 문단의 `equation_idx` 번째 컨트롤(수식)의 속성을 바꾼다.
+    /// [`Self::set_equation_properties_native`] 의 셀 경로는 문단의 **첫** 수식만 고친다.
+    #[allow(clippy::too_many_arguments)]
+    pub fn set_cell_equation_properties_native(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        control_idx: usize,
+        cell_idx: usize,
+        cell_para_idx: usize,
+        equation_idx: usize,
+        props_json: &str,
+    ) -> Result<String, HwpError> {
+        let dpi = self.dpi;
+        let para =
+            self.get_cell_paragraph_mut(section_idx, parent_para_idx, control_idx, cell_idx, cell_para_idx)?;
+        let Some(Control::Equation(eq)) = para.controls.get_mut(equation_idx) else {
+            return Err(HwpError::RenderError("셀 문단의 그 자리에 수식이 없습니다".to_string()));
+        };
+        Self::apply_equation_properties(eq, dpi, props_json);
+        self.mark_cell_control_dirty(section_idx, parent_para_idx, control_idx);
