diff --git a/src/document_core/commands/object_ops/common.rs b/src/document_core/commands/object_ops/common.rs
index 9d15d48c..4b8d4322 100644
--- a/src/document_core/commands/object_ops/common.rs
+++ b/src/document_core/commands/object_ops/common.rs
@@ -464,4 +464,54 @@ impl crate::document_core::DocumentCore {
             insert_idx
         )))
     }
+
+    /// [hwpedit] 쪽 번호 매기기: 쪽 번호 위치('pgnp') 컨트롤을 넣는다. 같은 문단에 이미
+    /// 있으면 그 컨트롤의 값만 바꾼다(한 문단에 둘을 쌓지 않음). 위치는 새 번호와 같은
+    /// 방식으로 `char_offset` 의 컨트롤 순서에 맞춘다 — 0 이면 구역/단 정의 뒤.
+    pub fn insert_page_number_pos_native(
+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        char_offset: usize,
+        pnp: crate::model::control::PageNumberPos,
+    ) -> Result<String, crate::error::HwpError> {
+        use crate::error::HwpError;
+        use crate::model::control::Control;
+
+        let paragraph = self
+            .document
+            .sections
+            .get_mut(section_idx)
+            .ok_or_else(|| HwpError::RenderError(format!("구역 인덱스 {} 범위 초과", section_idx)))?
+            .paragraphs
+            .get_mut(para_idx)
+            .ok_or_else(|| HwpError::RenderError(format!("문단 인덱스 {} 범위 초과", para_idx)))?;
+        if let Some(existing) = paragraph.controls.iter_mut().find_map(|c| match c {
+            Control::PageNumberPos(p) => Some(p),
+            _ => None,
+        }) {
+            *existing = pnp;
+            self.document.sections[section_idx].raw_stream = None;
+        } else {
+            self.document.sections[section_idx].raw_stream = None;
+            let paragraph = &mut self.document.sections[section_idx].paragraphs[para_idx];
+            let insert_idx = {
+                let positions = crate::document_core::helpers::find_control_text_positions(paragraph);
+                positions.iter().position(|&pos| pos > char_offset).unwrap_or(paragraph.controls.len())
+            };
+            paragraph.align_ctrl_data_records();
+            paragraph.controls.insert(insert_idx, Control::PageNumberPos(pnp));
+            paragraph.ctrl_data_records.insert(insert_idx, None);
+            paragraph.shift_for_inline_control_insert(insert_idx, char_offset);
+            paragraph.char_count += 8;
+            paragraph.control_mask |= 1u32 << 0x0015;
+            paragraph.has_para_text = true;
+            self.shift_active_field_for_control_insert(section_idx, para_idx, insert_idx);
+            self.reflow_paragraph(section_idx, para_idx);
+        }
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+        self.invalidate_page_tree_cache();
+        Ok(crate::document_core::helpers::json_ok())
+    }
 }
